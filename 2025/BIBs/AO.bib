	year = 2024
}


@inproceedings{10.2991/978-94-6463-256-9_156,
	abstract = {In order to reduce traffic accidents on special sections of mountainous highways and optimize individual driving behaviors, a behavioral map for studying individual driving behaviors is proposed. Based on simulated driving behavior data of individual drivers on mountainous highways, the statistical characteristics of driving behaviors are studied. The acceleration, deceleration, and steering wheel angle of the vehicle are selected as the feature indicators to describe individual driving behaviors, and a graph-based individual driving behavior feature expression method is constructed to study the supply-demand differences between different driving behaviors and road conditions. The results show that the driving behavior map can not only accurately and intuitively express the relationship between driving behavior and driving safety, but also clearly display the conflicts between road condition supply and driving behavior demand. The research results provide reasonable suggestions and solutions for alleviating supply-demand conflicts and behavior control, and improve the safety and operational efficiency of road traffic.},
	author = {Guoqing Liu},
	booktitle = {Proceedings of the 2023 4th International Conference on Management Science and Engineering Management (ICMSEM 2023)},
	doi = {10.2991/978-94-6463-256-9_156},
	keywords = {driving behavior, graph representation, feature classification, supply-demand difference analysis},
	month = {jan},
	publisher = {Springer},
	title = {Differentiation Analysis Between Driving Demand Based on Driving Atlas and Road Supply},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.2991/978-94-6463-256-9_156},
	year = 2024
}


@inproceedings{10.1007/978-3-031-70068-2_19,
	abstract = {Surrogate-assisted evolutionary algorithms (SAEAs) are recently among the most widely studied methods for their capability to solve expensive real-world optimization problems. However, the development of new methods and benchmarking with other techniques still relies almost exclusively on artificially created problems. In this paper, we use two real-world computational fluid dynamics problems to compare the performance of eleven state-of-the-art single-objective SAEAs. We analyze the performance by investigating the quality and robustness of the obtained solutions and the convergence properties of the selected methods. Our findings suggest that the more recently published methods, as well as the techniques that utilize differential evolution as one of their optimization mechanisms, perform significantly better than the other considered methods.},
	author = {Jakub Kůdela and Ladislav Dobrovský},
	booktitle = {Parallel Problem Solving from Nature – PPSN XVIII},
	doi = {10.1007/978-3-031-70068-2_19},
	keywords = {Expensive optimization, evolutionary algorithm, surrogate model, computational fluid dynamics, benchmarking},
	month = {jan},
	publisher = {Springer},
	title = {Performance Comparison of Surrogate-Assisted Evolutionary Algorithms on Computational Fluid Dynamics Problems},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-70068-2_19},
	year = 2024
}


@inproceedings{10.1007/978-981-97-8658-9_34,
	abstract = {In this paper, a Tube-MPC-based control method is proposed for elastic hypersonic vehicle with input delay. Firstly the polytopic LPV longitudinal model of elastic hypersonic vehicle with input delay is obtained. In order to deal with the delay effectively, the state transformation is implemented to convert the original LPV model into the new model without input delay. Secondly, a robust feedback controller and nominal controller of Tube-MPC are designed based on the delay-free polytopic LPV model. Then, the notching filter is combined in pitch rate dynamics to suppress the influence of elasticity. Finally, the effectiveness of the proposed control strategy is verified by simulation.},
	author = {Yueyang Wang and Hanpeng Mi and Chaofang Hu},
	booktitle = {Proceedings of 2024 Chinese Intelligent Systems Conference},
	doi = {10.1007/978-981-97-8658-9_34},
	keywords = {Hypersonic vehicle, Elasticity, Input delay, Tube-MPC, Notching filter},
	month = {jan},
	publisher = {Springer},
	title = {Tube-MPC-Based Robust Control Method of Elastic Hypersonic Vehicle with Input Delay},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-981-97-8658-9_34},
	year = 2024
}


