	title = {Dynamics of an Eccentric Crank-Slider Mechanism with a Flexible Drive and Frictional Joints},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-70251-8_14},
	year = 2024
}


@inproceedings{10.1007/978-3-031-49342-3_1,
	abstract = {This paper proposes a formal model for a subset of the startup finance transaction space. The initial version of the provided domain is the result of an industry coalition effort to make the data model standard. The data definition explains how this domain can be modeled syntactically. We refined this first model with semantics on transactions by using the Alloy formal modeling language and analyzer, aiming for a more expressive and correct model by capturing domain invariants. As a result, the new model is machine-checkable for important safety integrity criteria. This research contributes to the field of formal methods by demonstrating how to progress from a semi-formal specification to a formal one, evaluating the results, and providing a case study of a real-world domain.},
	author = {Rodrigo Stevaux and Ana C. V. Melo},
	booktitle = {Formal Methods: Foundations and Applications},
	doi = {10.1007/978-3-031-49342-3_1},
	keywords = {Formal methods, Financial modeling, Alloy},
	month = {jan},
	publisher = {Springer},
	title = {A Formal Model for Startups Financial Transactions},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-49342-3_1},
	year = 2024
}


@inproceedings{10.1007/978-3-031-58094-9_61,
	abstract = {One key aspect of the fashion industry is the presence of small manufacturing companies and their need to present a sample collection to the reseller and find wholesalers. This Business-to-Business (B2B) activity is characterized by complex storytelling and communication methods to convey the value of the products: materials, finishes, sizes, and fit options. Usually, the showroom is used to present the garment collection, a representative of the manufacturer, and one or more resellers. Setting up a physical showroom is expensive and requires the transportation of the entire collection. During the pandemic, when physical interactions were severely limited, companies had to adopt alternative solutions by using the Internet to communicate with other companies. By the end of this period, the use of such solutions proved to be extremely convenient and practical. We present a Metaverse-based showroom, that differently from the literature focuses on B2B fashion showrooms instead of direct sales or retail. We based on the VRChat and used Head-Mounted Displays (HMD) to recreate a real-life showroom. The users are remotely seated at a shared desk in front of the catwalk. The reseller can interact with the following functions: collection presentation, fashion show participation, and material/color configuration. We conducted a user study with 10 expert subjects, simulating two remote-selling scenarios of a jacket collection from a partner company with real experienced sellers and distributors user and assessing the user experience measurement. The user test is measured with the User Experience Questionnaire (UEQ). The results showed positive evaluations in terms of attractivity, apprendibility, stimulation, originality, and positive outcomes regarding sustainability.},
	author = {Fabio Vangi and Marina Ricci and Annalisa Diroma and Michele Fiorentino},
	booktitle = {Design Tools and Methods in Industrial Engineering III},
	doi = {10.1007/978-3-031-58094-9_61},
	keywords = {Fashion Industry, Showroom, Metaverse, Virtual Reality, User Experience, Business-To-Business},
	month = {jan},
	publisher = {Springer},
	title = {Designing a Business-to-Business Virtual Fashion Showroom in the Metaverse: A Padded Jacket Case Study},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-58094-9_61},
	year = 2024
}


@inproceedings{10.1007/978-3-031-54204-6_5,
	abstract = {When cyber security analysts believe their computer network has been compromised, or feel uneasy about potential intrusions, they might initiate a threat hunting process. The success of a threat hunt is largely dependent on the threat hunter’s ability to determine what to investigate, sift through logs, and distinguish normal events from threats. However, these abilities are hard to come by, and it is therefore important to find ways to improve peoples’ ability to threat hunt. This paper presents the blueprint for Skade, a system to manage threat hunting challenges. Skade is designed to meet a number of established theories in the field of pedagogy: ensuring constructive alignment, motivating trainees by meeting Turner and Paris’ six Cs, providing useful feedback, and covering multiple learning dimensions. Mockups of the user interface of Skade and requirements on supporting scenario emulators are presented, e.g. the data they need to provide to enable generation of feedback to trainees. Seven required functions are identified, e.g. the ability to produce assessment questions based on logs from emulators.},
	author = {Teodor Sommestad and Henrik Karlzén and Hanna Kvist and Hanna Gustafsson},
	booktitle = {Computer Security. ESORICS 2023 International Workshops},
	doi = {10.1007/978-3-031-54204-6_5},
	keywords = {cyber security, threat hunting, education, cyber range},
	month = {jan},
	publisher = {Springer},
	title = {Skade – A Challenge Management System for Cyber Threat Hunting},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-54204-6_5},
	year = 2024
}


@inproceedings{10.1007/978-981-97-3324-8_34,
	abstract = {China’s electricity sector is experiencing a revolutionary transformation, with renewable energy progressively substituting traditional fossil fuels. The emergence of wind power as a major renewable energy source introduces unique challenges due to its unpredictable and fluctuating nature. Balancing the power grid becomes increasingly complex, and the issue of efficiently utilizing renewable energy becomes more pressing. This study concentrates on enhancing the management of renewable energy systems by leveraging short-term wind power forecasts. Given the growing share of renewable energy, maximizing stability and optimizing the absorption of new energy through effective dispatching are paramount.},
	author = {Yulong Han and Licai Guo and Haibo He},
	booktitle = {Proceedings of 2023 7th Chinese Conference on Swarm Intelligence and Cooperative Control},
	doi = {10.1007/978-981-97-3324-8_34},
	keywords = {Power System, Wind Power Prediction, Optimal Dispatch Strategy, Renewable Energy Power System},
	month = {jan},
	publisher = {Springer},
	title = {Renewable Energy System Optimization Decision Method Considering Wind Power Prediction},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-981-97-3324-8_34},
	year = 2024
}


@inproceedings{10.1007/978-3-031-37003-8_1,
	abstract = {The aim is to quantify model form uncertainty in a passive and active vibration isolation system example during a round-robin challenge among IMAC’s Model Validation and Uncertainty Quantification (MVUQ) technical division. In this context, passive means that the vibration isolation only depends on preset inertia, damping, and stiffness properties. Active means that additional controlled forces enhance the vibration isolation. The focus is on studying multiple mathematical models of the same one-mass oscillator system to predict its structural dynamic behavior against a consistent set of experimental data to ensure direct comparability. The models differ in their scope and complexity; the experimental data will be offered to different research groups that are yet to be constituted during this IMAC. The participants are welcome to join the research group and discuss their results in an exclusive IMAC session reserved for round-robin results in the following years.},
	author = {Roland Platz and Xinyue Xu and Sez Atamturktur},
	booktitle = {Model Validation and Uncertainty Quantification, Volume 3},
	doi = {10.1007/978-3-031-37003-8_1},
	keywords = {Model form uncertainty, Vibration isolation, Round-robin challenge},
	month = {jan},
	publisher = {Springer},
	title = {Introducing a Round-Robin Challenge to Quantify Model Form Uncertainty in Passive and Active Vibration Isolation},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-37003-8_1},
	year = 2024
}


@inproceedings{10.1007/978-3-031-70924-1_66,
	abstract = {In this paper, under regression model, a new bias estimator which is called Modified two-parameter unbiased estimator (MTURR) is presented to improve the efficiency of an estimator when the errors term suffers from heteroscedastic or correlated errors, and the independent variables have the multicollinearity problem. After getting the properties of the suggested estimator, its performance is compared with other competing estimators, depending on it has smaller mean squares error. The suggested estimator shows a clear advantage theoretically by obtaining the sufficient and necessary condition that enables it to do so. Its performance is associated with the estimated value of the two parameters k and d, which clearly affects the accuracy of MTURR. By using an applied example, we have shown from the tables and figures that the MTURR can be relied upon and used when the model suffers from these problems in its assumptions.},
	author = {Mustafa M. Abdullah and Mustafa I. Alheety},
	booktitle = {Recent Trends and Advances in Artificial Intelligence},
	doi = {10.1007/978-3-031-70924-1_66},
	keywords = {Heteroscedastic, Liu estimator, Unbiased estimator, Generalized least squares estimator, Two- parameter estimator, Mean squares error matrix},
	month = {jan},
	publisher = {Springer},
	title = {Modified New Estimator in Linear Regression Model Under Heteroscedastic or Correlated Errors},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-70924-1_66},
	year = 2024
}


@inproceedings{10.1007/978-981-97-3299-9_19,
	abstract = {Software publishing, consultancy, and supply are becoming very important in today’s global concern for making businesses sustainable. ErfindenTech Pvt. Ltd. is an enterprise started by Mr. Sachin Deshpande in November 2017. Today, supply chain has become important for businesses as a lot of costly resources are unnecessarily used thereby resulting in a lot of wastage. So, businesses nowadays have begun to measure the impact of their products and services on environment and society right from the start till the end of their life cycles. Attempts are made to reduce as much as possible societal and environmental harm by controlling factors like energy usage, water consumption, and waste production and going in for a streamlined operations procedure. ErfindenTech Pvt. Ltd. therefore offers software publishing, consultancy, and supply services. The researchers sought to study how ErfindenTech Pvt Ltd. strives to make businesses sustainable, through innovative operations solutions. The primary technique of research was qualitative in nature with the researchers conducting an interview of Mr. Sachin Deshpande, the founder of the enterprise. This method was supported by reference to a lot of secondary reading from reputed research journals and articles. The study showed that innovative technology-based solutions were utilized by Mr. Deshpande to make businesses sustainable in their operations. The study is important as SDGs have gained importance worldwide, and the business case for sustainable operations is growing stronger on a daily basis.},
	author = {Pradnya Vishwas Chitrao and Pravin Kumar Bhoyar and Rajiv Divekar},
	booktitle = {Proceedings of Ninth International Congress on Information and Communication Technology},
	doi = {10.1007/978-981-97-3299-9_19},
