@inproceedings{10.1007/978-981-97-8650-3_11,
	abstract = {This article solves a consensus problem of multi-agent systems with nonuniform position constraints, communication delays and switching topologies. A distributed control protocol is proposed for the consensus achievement. The novel concepts of dynamic compression point and scaling factor were introduced to ensure agents positions remain within some constraint sets. Through a series of system transformations and analysing the distance between each agent and the common constraint set, it is demonstrated that all agents ultimately achieve consensus while ensuring their positions remain within the given constraint sets. Finally, simulation examples are given to elucidate the conclusions.},
	author = {Cong Han},
	booktitle = {Proceedings of 2024 Chinese Intelligent Systems Conference},
	doi = {10.1007/978-981-97-8650-3_11},
	keywords = {Multi-agent systems, Position constraints, Constrained consensus},
	month = {jan},
	publisher = {Springer},
	title = {Distributed Position Constrained Consensus of Second-Order Multi-agent Systems with Switching Topologies},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-981-97-8650-3_11},
	year = 2024
}


@inproceedings{10.1007/978-981-99-9625-4_42,
	abstract = {This work deals with robust design optimization (RDO) of structures when information about the input parameters is not adequate to treat them probabilistically. This case often arises while designing a structure under surface blast loading. Neither the mean, standard deviation, nor the probability distribution function is available for surface blast parameters, like charge weight, stand-off distance, overpressure, duration of the pulse, shock front velocity, drag coefficient, etc. In such cases, the parameters can be treated as interval types, where only the ranges of variations of the uncertain parameters are sufficient to model them in a hyper-ellipsoidal convex domain. Subsequently, a convex programming (CP) approach can be used to optimize the system. This approach works fine for simple deterministic systems where loading is equivalent to static in nature. But, the surface blast is a dynamic impulse type load with significant stochastic characteristics. The time-history of blast loading varies significantly even with the same hazard parameter setup due to the inherent uncertainty associated with blast load modeling. A new dual response surface method (RSM)-based RDO procedure is developed in the present paper. The dual RSM captures the stochastic nature of load time-history which in-turn is used to develop a new formulation of RDO. The effectiveness of the proposed approach is explained using a numerical problem of an RC 20-storied building. The RDO is solved by sequential quadratic programming. The results of RDO are compared with the conventional IS: 4991- 1968 based approach to indicate the need for the present approach.},
	author = {Sujit Das and Soumya Bhattacharjya},
	booktitle = {Recent Developments in Structural Engineering, Volume 1},
	doi = {10.1007/978-981-99-9625-4_42},
	keywords = {Robust design optimization, Interval parameters, Convex programming, Dual response surface method, Surface blast load},
	month = {jan},
	publisher = {Springer},
	title = {An Efficient Dual Response Surface-Based Convex Robust Optimization of Multi-storied RC Buildings Subjected to Surface Blast Loading Characterized by Interval Uncertainty},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-981-99-9625-4_42},
	year = 2024
}


@inproceedings{10.1007/978-3-031-72980-5_7,
	abstract = {Diffusion models have revolutionized image editing but often generate images that violate physical laws, particularly the effects of objects on the scene, e.g., occlusions, shadows, and reflections. By analyzing the limitations of self-supervised approaches, we propose a practical solution centered on a “counterfactual” dataset. Our method involves capturing a scene before and after removing a single object, while minimizing other changes. By fine-tuning a diffusion model on this dataset, we are able to not only remove objects but also their effects on the scene. However, we find that applying this approach for photorealistic object insertion requires an impractically large dataset. To tackle this challenge, we propose bootstrap supervision; leveraging our object removal model trained on a small counterfactual dataset, we synthetically expand this dataset considerably. Our approach significantly outperforms prior methods in photorealistic object removal and insertion, particularly in modeling the effects of objects on the scene.},
	author = {Daniel Winter and Matan Cohen and Shlomi Fruchter and Yael Pritch and Alex Rav-Acha and Yedid Hoshen},
	booktitle = {Computer Vision – ECCV 2024},
	doi = {10.1007/978-3-031-72980-5_7},
	month = {jan},
	publisher = {Springer},
	title = {ObjectDrop: Bootstrapping Counterfactuals for Photorealistic Object Removal and Insertion},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-72980-5_7},
	year = 2024
}


@inproceedings{10.1007/978-3-031-54813-0_30,
	abstract = {The pervasive integration of Artificial Intelligence (AI) across diverse sectors, from economy to health, has brought forth transformative benefits. Yet, this transformation is accompanied by intricate ethical quandaries and potential hazards. These include privacy breaches, bias, discrimination, opacity, and the erosion of human dignity. Such concerns hold the potential to erode public trust and impede the societal and legal advancement of AI systems. Consequently, ensuring an ethical and responsible AI development approach that upholds human values and rights becomes imperative. This paper offers an extensive and critical examination of the central ethical challenges originating from the emergence and deployment of AI systems. It also delves into established ethical frameworks, such as those introduced by the European Commission, IEEE, and OECD, while highlighting existing gaps like enforceability, inclusivity, and stakeholder engagement. Furthermore, the paper proposes recommendations and best practices that facilitate the alignment of AI with human values and the promotion of societal welfare. Interdisciplinary collaboration among stakeholders, including researchers and practitioners, emerges as a pivotal element.},
	author = {Iveta Dirgová Luptáková and Jiří Pospíchal and Ladislav Huraj},
	booktitle = {Software Engineering Methods in Systems and Network Systems},
	doi = {10.1007/978-3-031-54813-0_30},
	keywords = {AI ethics, Accountability in AI, Transparency in AI, AI bias, AI regulation, AI safety},
	month = {jan},
	publisher = {Springer},
	title = {Beyond Code and Algorithms: Navigating Ethical Complexities in Artificial Intelligence},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-54813-0_30},
	year = 2024
}


@inproceedings{10.1007/978-3-031-62554-1_1,
	abstract = {There is limited integration across the Department of Defense (DoD) acquisition policy documents, DoD acquisition guidelines, and the systems engineering standards. One of the underlying reasons for the lack of integration is the inconsistent terminology across policies and guidelines generated by various organizations and groups. This paper outlines a methodology based on semantic networks and natural language processing methods to assess the similarity of idiosyncratic representation of concepts generated by different groups, in particular acquisition and systems engineering groups. The methodology has practical implications in terms of establishing a shared knowledge base across different organizations and facilitating the development of a digital ontology of systems engineering modernization focus areas relevant to the systems engineering and acquisition groups.},
	author = {Nil Kilicay-Ergin and Adrian Barb},
	booktitle = {The Proceedings of the 2024 Conference on Systems Engineering Research},
	doi = {10.1007/978-3-031-62554-1_1},
	keywords = {Digital ontology, Semantic networks, Natural language processing, DoD acquisition guidelines, Systems engineering standard},
	month = {jan},
	publisher = {Springer},
	title = {Toward Deriving a Digital Ontology for Systems Engineering and Acquisition Groups},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-62554-1_1},
	year = 2024
}


@inproceedings{10.1007/978-3-031-70445-1_25,
	abstract = {In learning how to design information systems, the specification of diagram order might speed up or slow down the work on the system design. Our study introduces and examines an order selection methodology employing different strategies using similarity or difference in the number of elements. The performance of these strategies was assessed by comparing their potential cumulative coverage of elements and diagrams. The results indicate that the strategy maximizing the number of new elements per selection provides the quickest total coverage of elements. The insights provided in this position paper might help educators select the most effective order of diagrams to teach students, thus enhancing their understanding and efficiency in system modeling.},
	author = {Anna Suchenia and Karol Suchenia and Marek Adrian and Krystian Jobczyk and Piotr Wiśniewski and Antoni Ligęza},
	booktitle = {Business Process Management: Blockchain, Robotic Process Automation, Central and Eastern European, Educators and Industry Forum},
	doi = {10.1007/978-3-031-70445-1_25},
	keywords = {Teaching Strategies, Software Modeling Education, System Design Education, Modeling Process, Information Systems Design},
	month = {jan},
	publisher = {Springer},
	title = {Order Selection Methodology of OMG Diagrams in Teaching Designing Information Systems},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-3-031-70445-1_25},
	year = 2024
}


@article{10.1007/s11235-023-01064-8,
	abstract = {Intent-based networking (IBN) is an evolutionary paradigm. Its recent adaptation has been increased substantially by Cloud Service Providers, Telecom, and network operators due to its automation capabilities. However, there are certain challenges specifically related to security. One of the core challenges is the lack of a forensic framework for identifying different incidents inside IBN. In this paper, we have proposed a framework to perform the forensics investigation of an IBN inside a software defined networking (SDN) environment. This framework is based on the steps of the forensics investigation process and consists of four modules: Identification, Collection, Analysis, and Reporting. Identification includes logs searching for specific events. Logs are searched through keywords, Time, Date, and Event ID. Pieces of evidence are collected from the Application, Control, and Infrastructure Layers of SDN by exploiting the default log file of ONOS and third-party tools. The analysis is performed using manual analysis of the raw log entries and third-party tools such as Loki/Grafana. This framework is implemented by utilizing ONOS as an SDN controller. The emulator used for creating the experimental network is Mininet on two different use cases: Normal Traffic Routing and Redirection of Attack Traffic, to analyze the difference in log files generated by the SDN controller. These files are manually analyzed and sent to the Loki–Grafana server for better analysis, visualization, and real-time monitoring of IBN logs. Assessment of the obtained experimental results is based on the states defined in the Intent Framework of ONOS.},
	author = {Muhammad Faraz Hyder and Tasbiha Fatima and Saadia Arshad},
	doi = {10.1007/s11235-023-01064-8},
	journal = {Telecommunication Systems},
	keywords = {Distributed denial of service attacks, Intent-based networking, IBN forensics, Software defined networking, SDN forensics},
	month = {jan},
	number = 1,
	page = {11–27},
	publisher = {Springer},
	title = {Digital forensics framework for intent-based networking over software-defined networks},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/s11235-023-01064-8},
	volume = 85,
	year = 2024
}


