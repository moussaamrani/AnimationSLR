 d ≥ 2 .},
	author = {Zhenhao Cai and Eviatar B. Procaccia and Yuan Zhang},
	doi = {10.1007/s00440-025-01393-6},
	journal = {Probability Theory and Related Fields},
	keywords = {30C85, 31A15, 60G50, 82C41},
