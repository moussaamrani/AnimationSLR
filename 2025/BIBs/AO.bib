	doi = {10.1007/978-981-16-6936-1_2},
	keywords = {Driving cycle, Acceleration, Deceleration, Idle, Influence zone},
	month = {jan},
	publisher = {Springer},
	title = {Microscopic Traffic Simulation Approach to Evaluate Driving Parameters at Influence Zone of the Intersection},
	url = {http://link.springer.com/openurl/pdf?id=doi:10.1007/978-981-16-6936-1_2},
